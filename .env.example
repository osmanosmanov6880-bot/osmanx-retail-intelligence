# LOCAL DEMO ONLY. Synthetic data, admin API deliberately open.
OSMANX_DEMO_MODE=1
OSMANX_DATA_DIR=./data

# REAL MODE: set DEMO_MODE=0 and use strong random secrets. Do not commit .env.
# OSMANX_DEMO_MODE=0
# OSMANX_ADMIN_PASSWORD=replace-with-a-strong-private-password
# OSMANX_SESSION_SECRET=replace-with-a-32-plus-character-random-secret
# OSMANX_INGEST_KEY=replace-with-a-private-sensor-key

# R0.3: for signed traffic/zone devices, use a separate 32+ character key.
# OSMANX_DEVICE_MASTER_SECRET=replace-with-a-second-strong-random-secret
# OSMANX_BOOTSTRAP_EMAIL=owner@yourcompany.example
# Old OSMANX_INGEST_KEY endpoints are disabled in production; use signed v2.
# The admin password bootstraps the initial account on first start; afterwards its hash is in SQLite.
